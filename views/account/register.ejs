<h1><%= title %></h1>

<%- messages() %>

<% if (errors) { %>
  <ul class="notice">
    <% errors.array().forEach(error => { %>
      <li><%= error.msg %></li>
    <% }) %>
  </ul>
<% } %>

<div id="register-wrapper">
  <form action="/account/register" method="post" id="register-form">
    <fieldset>
      <legend>Create Account</legend>

      <label for="account_firstname">First Name <span class="required">*</span></label>
      <input
        type="text"
        name="account_firstname"
        id="account_firstname"
        placeholder="Enter first name"
        value="<%= locals.account_firstname || '' %>"
        required
      />

      <label for="account_lastname">Last Name <span class="required">*</span></label>
      <input
        type="text"
        name="account_lastname"
        id="account_lastname"
        placeholder="Enter last name"
        value="<%= locals.account_lastname || '' %>"
        required
      />

      <label for="account_email">Email Address <span class="required">*</span></label>
      <input
        type="email"
        name="account_email"
        id="account_email"
        placeholder="Enter email address"
        value="<%= locals.account_email || '' %>"
        required
      />

      <label for="account_password">Password <span class="required">*</span></label>
      <div class="password-rules">
        Passwords must be at least 12 characters and contain at least 1 number, 1 capital letter, 1 lowercase letter, and 1 special character. No spaces allowed.
      </div>
      <div class="password-input-wrapper">
        <input
          type="password"
          name="account_password"
          id="account_password"
          placeholder="Enter password"
          pattern="^(?=.*\d)(?=.*[a-z])(?=.*[A-Z])(?=.*[^a-zA-Z0-9])(?!.*\s).{12,}$"
          title="Must be at least 12 characters and contain at least 1 number, 1 capital letter, 1 lowercase letter, and 1 special character. No spaces."
          required
        />
        <button type="button" id="togglePassword" class="toggle-password-btn">Show</button>
      </div>

      <button type="submit" class="register-btn">Register</button>
    </fieldset>
  </form>

  <p class="login-link">
    Already have an account? <a href="/account/login">Click here to log in</a>
  </p>
</div>

<script>
  document.getElementById("togglePassword").addEventListener("click", function () {
    const passwordInput = document.getElementById("account_password")
    const isHidden = passwordInput.type === "password"
    passwordInput.type = isHidden ? "text" : "password"
    this.textContent = isHidden ? "Hide" : "Show"
  })
</script>
