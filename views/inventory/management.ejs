<h1><%= title %></h1>

<%- messages() %>

<% if (errors) { %>
  <ul class="notice">
    <% errors.array().forEach(error => { %>
      <li><%= error.msg %></li>
    <% }) %>
  </ul>
<% } %>

<div id="inv-mgmt">
  <h2>Vehicle Management</h2>
  <nav class="mgmt-nav">
    <a href="/inv/add-classification" class="mgmt-link">Add New Classification</a>
    <a href="/inv/add-inventory" class="mgmt-link">Add New Vehicle</a>
  </nav>

  <h2>Manage Inventory</h2>
  <p>Select a classification to see the vehicles below, then use the links to modify or delete.</p>

  <%- classificationList %>

  <table id="inventoryDisplay">
  </table>

  <noscript>
    <p>JavaScript is required to use the inventory management table.</p>
  </noscript>
</div>

<script src="/js/inventory.js"></script>
